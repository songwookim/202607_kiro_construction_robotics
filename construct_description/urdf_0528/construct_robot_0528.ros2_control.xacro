<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:macro
    name="construct_robot_0528_ros2_control"
    params="left_robot_ip right_robot_ip cb_simulation:=false use_fake_left_hardware:=true use_fake_right_hardware:=false use_initial_left_positions:=true use_initial_right_positions:=true initial_positions_file fake_sensor_commands:=false">

    <xacro:property name="initial_positions"
                    value="${xacro.load_yaml(initial_positions_file)['initial_positions']}" />

    <xacro:macro name="configure_rb_joint" params="joint_name initial_value:=0.0">
      <joint name="${joint_name}">
        <param name="initial_position">${initial_value}</param>
        <param name="torque_constant">1.0</param>
        <command_interface name="effort" />
        <command_interface name="velocity" />
        <command_interface name="position" />
        <state_interface name="position">
          <param name="initial_value">${initial_value}</param>
        </state_interface>
        <state_interface name="effort">
          <param name="initial_value">0.0</param>
        </state_interface>
      </joint>
    </xacro:macro>

    <ros2_control name="LeftRBPodoHardwareInterface" type="system">
      <hardware>
        <xacro:if value="${use_fake_left_hardware}">
          <plugin>mock_components/GenericSystem</plugin>
          <param name="mock_sensor_commands">${fake_sensor_commands}</param>
          <param name="state_following_offset">0.0</param>
        </xacro:if>
        <xacro:unless value="${use_fake_left_hardware}">
          <plugin>rbpodo_hardware/RBPodoHardwareInterface</plugin>
          <param name="hardware_namespace">left</param>
          <param name="cb_simulation">${cb_simulation}</param>
          <param name="robot_ip">${left_robot_ip}</param>
        </xacro:unless>
      </hardware>
      <xacro:configure_rb_joint joint_name="left_manipulator_joint1" initial_value="${initial_positions['left_manipulator_joint1'] if use_initial_left_positions else 0.0}" />
      <xacro:configure_rb_joint joint_name="left_manipulator_joint2" initial_value="${initial_positions['left_manipulator_joint2'] if use_initial_left_positions else 0.0}" />
      <xacro:configure_rb_joint joint_name="left_manipulator_joint3" initial_value="${initial_positions['left_manipulator_joint3'] if use_initial_left_positions else 0.0}" />
      <xacro:configure_rb_joint joint_name="left_manipulator_joint4" initial_value="${initial_positions['left_manipulator_joint4'] if use_initial_left_positions else 0.0}" />
      <xacro:configure_rb_joint joint_name="left_manipulator_joint5" initial_value="${initial_positions['left_manipulator_joint5'] if use_initial_left_positions else 0.0}" />
      <xacro:configure_rb_joint joint_name="left_manipulator_joint6" initial_value="${initial_positions['left_manipulator_joint6'] if use_initial_left_positions else 0.0}" />
    </ros2_control>

    <ros2_control name="RightRBPodoHardwareInterface" type="system">
      <hardware>
        <xacro:if value="${use_fake_right_hardware}">
          <plugin>mock_components/GenericSystem</plugin>
          <param name="mock_sensor_commands">${fake_sensor_commands}</param>
          <param name="state_following_offset">0.0</param>
        </xacro:if>
        <xacro:unless value="${use_fake_right_hardware}">
          <plugin>rbpodo_hardware/RBPodoHardwareInterface</plugin>
          <param name="hardware_namespace">right</param>
          <param name="cb_simulation">${cb_simulation}</param>
          <param name="robot_ip">${right_robot_ip}</param>
        </xacro:unless>
      </hardware>
      <xacro:configure_rb_joint joint_name="right_manipulator_joint1" initial_value="${initial_positions['right_manipulator_joint1'] if use_initial_right_positions else 0.0}" />
      <xacro:configure_rb_joint joint_name="right_manipulator_joint2" initial_value="${initial_positions['right_manipulator_joint2'] if use_initial_right_positions else 0.0}" />
      <xacro:configure_rb_joint joint_name="right_manipulator_joint3" initial_value="${initial_positions['right_manipulator_joint3'] if use_initial_right_positions else 0.0}" />
      <xacro:configure_rb_joint joint_name="right_manipulator_joint4" initial_value="${initial_positions['right_manipulator_joint4'] if use_initial_right_positions else 0.0}" />
      <xacro:configure_rb_joint joint_name="right_manipulator_joint5" initial_value="${initial_positions['right_manipulator_joint5'] if use_initial_right_positions else 0.0}" />
      <xacro:configure_rb_joint joint_name="right_manipulator_joint6" initial_value="${initial_positions['right_manipulator_joint6'] if use_initial_right_positions else 0.0}" />
    </ros2_control>

    <!-- The two-axis head is MoveIt-only and never connects to an RB Control Box. -->
    <ros2_control name="HeadMoveItSystem" type="system">
      <hardware>
        <plugin>mock_components/GenericSystem</plugin>
        <param name="mock_sensor_commands">${fake_sensor_commands}</param>
        <param name="state_following_offset">0.0</param>
      </hardware>
      <joint name="robot_head_rev_joint1">
        <param name="initial_position">0.0</param>
        <command_interface name="position" />
        <state_interface name="position">
          <param name="initial_value">0.0</param>
        </state_interface>
      </joint>
      <joint name="robot_head_rev_joint2">
        <param name="initial_position">0.0</param>
        <command_interface name="position" />
        <state_interface name="position">
          <param name="initial_value">0.0</param>
        </state_interface>
      </joint>
    </ros2_control>
  </xacro:macro>
</robot>
