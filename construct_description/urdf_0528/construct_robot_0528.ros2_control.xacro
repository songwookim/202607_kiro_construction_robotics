<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:macro
    name="construct_robot_0528_ros2_control"
    params="left_robot_ip right_robot_ip cb_simulation:=false use_fake_left_hardware:=false use_fake_right_hardware:=false fake_sensor_commands:=false">

    <xacro:macro name="configure_rb_joint" params="joint_name initial_value:=0.0">
      <joint name="${joint_name}">
        <param name="initial_position">${initial_value}</param>
        <param name="torque_constant">1.0</param>
        <command_interface name="effort" />
        <command_interface name="velocity" />
        <command_interface name="position" />
        <state_interface name="position">
          <param name="initial_value">${initial_value}</param>
        </state_interface>
        <state_interface name="effort">
          <param name="initial_value">0.0</param>
        </state_interface>
      </joint>
    </xacro:macro>

    <ros2_control name="LeftRBPodoHardwareInterface" type="system">
      <hardware>
        <xacro:if value="${use_fake_left_hardware}">
          <plugin>mock_components/GenericSystem</plugin>
          <param name="mock_sensor_commands">${fake_sensor_commands}</param>
          <param name="state_following_offset">0.0</param>
        </xacro:if>
        <xacro:unless value="${use_fake_left_hardware}">
          <plugin>rbpodo_hardware/RBPodoHardwareInterface</plugin>
          <param name="hardware_namespace">left</param>
          <param name="cb_simulation">${cb_simulation}</param>
          <param name="robot_ip">${left_robot_ip}</param>
        </xacro:unless>
      </hardware>
      <xacro:configure_rb_joint joint_name="left_manipulator_joint1" />
      <xacro:configure_rb_joint joint_name="left_manipulator_joint2" />
      <xacro:configure_rb_joint joint_name="left_manipulator_joint3" />
      <xacro:configure_rb_joint joint_name="left_manipulator_joint4" />
      <xacro:configure_rb_joint joint_name="left_manipulator_joint5" />
      <xacro:configure_rb_joint joint_name="left_manipulator_joint6" />
    </ros2_control>

    <ros2_control name="RightRBPodoHardwareInterface" type="system">
      <hardware>
        <xacro:if value="${use_fake_right_hardware}">
          <plugin>mock_components/GenericSystem</plugin>
          <param name="mock_sensor_commands">${fake_sensor_commands}</param>
          <param name="state_following_offset">0.0</param>
        </xacro:if>
        <xacro:unless value="${use_fake_right_hardware}">
          <plugin>rbpodo_hardware/RBPodoHardwareInterface</plugin>
          <param name="hardware_namespace">right</param>
          <param name="cb_simulation">${cb_simulation}</param>
          <param name="robot_ip">${right_robot_ip}</param>
        </xacro:unless>
      </hardware>
      <xacro:configure_rb_joint joint_name="right_manipulator_joint1" />
      <xacro:configure_rb_joint joint_name="right_manipulator_joint2" />
      <xacro:configure_rb_joint joint_name="right_manipulator_joint3" />
      <xacro:configure_rb_joint joint_name="right_manipulator_joint4" />
      <xacro:configure_rb_joint joint_name="right_manipulator_joint5" />
      <xacro:configure_rb_joint joint_name="right_manipulator_joint6" />
    </ros2_control>

    <!-- The two-axis head is MoveIt-only and never connects to an RB Control Box. -->
    <ros2_control name="HeadMoveItSystem" type="system">
      <!-- <hardware>
        <plugin>mock_components/GenericSystem</plugin>
        <param name="mock_sensor_commands">${fake_sensor_commands}</param>
        <param name="state_following_offset">0.0</param>
      </hardware>
      <joint name="robot_head_rev_joint1">
        <param name="initial_position">0.0</param>
        <command_interface name="position" />
        <state_interface name="position">
          <param name="initial_value">0.0</param>
        </state_interface>
      </joint>
      <joint name="robot_head_rev_joint2">
        <param name="initial_position">0.0</param>
        <command_interface name="position" />
        <state_interface name="position">
          <param name="initial_value">0.0</param>
        </state_interface>
      </joint> -->
        <hardware>
            <plugin>kaiser_hardware/KaiserHardwareInterface</plugin>
            <param name="can_interface">can2</param>

        </hardware>
        <joint name="robot_head_rev_joint1">
            <param name="motor_id">2</param>
            <command_interface name="position" />
            <state_interface name="position" />
            <state_interface name="velocity" />
            <!-- <state_interface name="current" />
            <state_interface name="status" />
            <state_interface name="error" /> -->
        </joint>
        <joint name="robot_head_rev_joint2">
            <param name="motor_id">1</param>
            <command_interface name="position" />
            <state_interface name="position" />
            <state_interface name="velocity" />
            <!-- <state_interface name="current" />
            <state_interface name="status" />
            <state_interface name="error" /> -->
        </joint>
    </ros2_control>
  </xacro:macro>
</robot>
