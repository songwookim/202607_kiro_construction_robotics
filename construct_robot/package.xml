<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>construct_robot</name>
  <version>0.1.0</version>
  <description>Action nodes and planning utilities for the KIRO construction robot.</description>
  <maintainer email="thddn191@gmail.com">irs</maintainer>
  <license>Apache-2.0</license>

  <depend>construct_msgs</depend>
  <exec_depend>construct_description</exec_depend>
  <exec_depend>construct_moveit_config</exec_depend>
  <exec_depend>controller_manager</exec_depend>
  <depend>geometry_msgs</depend>
  <exec_depend>joint_state_broadcaster</exec_depend>
  <exec_depend>joint_trajectory_controller</exec_depend>
  <depend>moveit_msgs</depend>
  <exec_depend>rbpodo_hardware</exec_depend>
  <depend>rclpy</depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <depend>sensor_msgs</depend>
  <depend>std_msgs</depend>
  <depend>tf2_ros</depend>
  <depend>visualization_msgs</depend>
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>python3-tk</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>xacro</exec_depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
