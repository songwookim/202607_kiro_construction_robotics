# Ordered Cartesian 6D poses requested by the client.
geometry_msgs/Pose[] waypoints
string planning_group
float64 interpolation_step
# 0.01..1.0 multiplier applied to trajectory velocity and timing.
float64 velocity_scale
# Plan-only previews and exact execution of the last matching approved plan.
bool execute_requested
bool reuse_approved_plan
# Visualization only. Welding is controlled separately through Hi-COMM.
bool visualize_path
---
# The final 6D pose and all simulated samples generated by the server.
bool success
string message
geometry_msgs/Pose final_pose
geometry_msgs/Pose[] sampled_path
---
# Current simulated 6D pose while processing the path.
geometry_msgs/Pose current_pose
uint32 waypoint_index
float32 progress
string phase
