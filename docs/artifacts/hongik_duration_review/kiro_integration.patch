+"""Site arguments and scoped NumPy/SciPy loading; no nodes started."""
+
+import importlib.util
+import os
+from pathlib import Path
+import subprocess
+from unittest.mock import patch
+
+import pytest
+
+
+def launch_module():
+    source = Path(__file__).resolve().parents[1] / "launch/hongik_precision_sensing.launch.py"
+    spec = importlib.util.spec_from_file_location("hongik_launch_test", source)
+    module = importlib.util.module_from_spec(spec)
+    spec.loader.exec_module(module)
+    return module
+
+
+def test_all_site_arguments_forwarded_and_confirmation_defaults_each():
+    from launch import LaunchContext
+    from launch.actions import DeclareLaunchArgument, OpaqueFunction
+    from ament_index_python.packages import get_package_share_directory
+
+    captured = []
+    with patch("launch_ros.actions.Node", side_effect=lambda **kw: captured.append(kw) or kw):
+        description = launch_module().generate_launch_description()
+        context = LaunchContext()
+        requested = dict(platform_config=str(Path(get_package_share_directory("hongik_scan_ros")) / "config/hongik_kiro.yaml"),
+                         job_file="/site/job.yaml", out_root="/site/runs", kiro_confirm_mode="each")
+        context.launch_configurations.update(requested)
+        for entity in description.entities:
+            if isinstance(entity, DeclareLaunchArgument):
+                entity.execute(context)
+        next(e for e in description.entities if isinstance(e, OpaqueFunction)).execute(context)
+    server = next(n for n in captured if n.get("executable") == "hongik_auto_teach_server")
+    for name, value in requested.items():
+        assert server["parameters"][0][name] == value
+    assert server["additional_env"]["PYTHONNOUSERSITE"] == "1"
+    assert "PYTHONPATH" not in server["additional_env"]
+    assert "construct_robot.nodes.hongik_auto_teach_server" in server["prefix"]
+
+
+@pytest.mark.parametrize("missing", ["platform_config", "job_file", "out_root"])
+def test_required_site_settings_do_not_fall_back_to_templates(missing):
+    from launch import LaunchContext
+    from launch.actions import DeclareLaunchArgument
+
+    context = LaunchContext()
+    context.launch_configurations.update({k: "/site/value" for k in ("platform_config", "job_file", "out_root") if k != missing})
+    description = launch_module().generate_launch_description()
+    with pytest.raises(RuntimeError, match=missing):
+        for entity in description.entities:
+            if isinstance(entity, DeclareLaunchArgument):
+                entity.execute(context)
+    confirm = next(e for e in description.entities if isinstance(e, DeclareLaunchArgument) and e.name == "kiro_confirm_mode")
+    assert "".join(s.text for s in confirm.default_value) == "each"
+
+
+def test_system_numeric_pair_and_spawn_entry_preserve_ros_search_path():
+    code = """
+import sys, runpy
+import importlib.util, multiprocessing
+from pathlib import Path
+before = list(sys.path)
+runpy.run_module('construct_robot.nodes.hongik_auto_teach_server', run_name='__mp_main__')
+import numpy, scipy
+from scipy.spatial.transform import Rotation
+assert before == sys.path
+for module in (numpy, scipy):
+    assert Path(module.__file__).is_relative_to('/usr/lib/python3/dist-packages')
+sys.modules['__main__'].__spec__ = importlib.util.find_spec('construct_robot.nodes.hongik_auto_teach_server')
+child_check = "import numpy, scipy; from scipy.spatial.transform import Rotation; assert numpy.__file__.startswith('/usr/lib/python3/dist-packages/'); assert scipy.__file__.startswith('/usr/lib/python3/dist-packages/')"
+child = multiprocessing.get_context('spawn').Process(target=exec, args=(child_check,))
+child.start()
+child.join(10.)
+assert child.exitcode == 0, child.exitcode
+print('system NumPy/SciPy and spawn entry passed; sys.path unchanged')
+"""
+    env = {**os.environ, "PYTHONDONTWRITEBYTECODE": "1", "PYTHONNOUSERSITE": "1"}
+    # No system dist-packages is prepended: exercise the actual conflicting host.
+    env["PYTHONPATH"] = os.pathsep.join(p for p in env.get("PYTHONPATH", "").split(os.pathsep)
+                                      if p != "/usr/lib/python3/dist-packages")
+    result = subprocess.run(["/usr/bin/python3", "-c", code], env=env, capture_output=True, text=True, timeout=20.)
+    assert result.returncode == 0, result.stderr
