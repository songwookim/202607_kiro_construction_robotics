+"""Compare Hongik plans by platform-limited duration alone."""
+
+import math
+
+PATH_ORDER = ("duration_s",)
+
+
+def joint_path_cost(plan):
+    """One scalar cost in a tuple; stable sorting retains input rank for ties."""
+    duration = float(plan["duration_s"])
+    if not math.isfinite(duration) or duration < 0:
+        raise ValueError("joint plan has invalid duration_s")
+    return (duration,)
diff --git a/construct_robot/construct_robot/nodes/hongik_auto_teach_server.py b/construct_robot/construct_robot/nodes/hongik_auto_teach_server.py
new file mode 100644
--- /dev/null
+++ b/construct_robot/construct_robot/nodes/hongik_auto_teach_server.py
@@ -0,0 +1,181 @@
+"""Run the delivered Hongik server with the reviewed KIRO trajectory patches.
+
+Only the two changed modules are compiled in memory. The delivered package and
+generated workspace files are never rewritten. A different upstream revision
+is refused before starting ROS, rather than applying a patch approximately.
+"""
+
+import hashlib
+import importlib
+import importlib.abc
+import importlib.machinery
+import importlib.util
+import json
+from pathlib import Path
+import re
+import sys
+
+
+def load_system_numeric_packages(system_path=Path("/usr/lib/python3/dist-packages")):
+    """Load only NumPy/SciPy from Ubuntu apt, without changing sys.path.
+
+    Both user-site and /usr/local wheels can shadow apt's ABI-compatible pair.
+    Do not remove installations or reorder unrelated ROS/Python modules.
+    """
+    packages = []
+    for name in ("numpy", "scipy"):
+        loaded = sys.modules.get(name)
+        if loaded is not None:
+            if not Path(loaded.__file__).resolve().is_relative_to(system_path.resolve()):
+                raise RuntimeError(f"{name} was imported from {loaded.__file__}; start the Hongik entry point in a fresh process")
+            packages.append(loaded)
+            continue
+        spec = importlib.machinery.PathFinder.find_spec(name, [str(system_path)])
+        if spec is None:
+            raise RuntimeError(f"system {name} unavailable; install python3-numpy and python3-scipy from apt")
+        module = importlib.util.module_from_spec(spec)
+        sys.modules[name] = module
+        try:
+            spec.loader.exec_module(module)
+        except BaseException:
+            sys.modules.pop(name, None)
+            raise
+        packages.append(module)
+    from scipy.spatial.transform import Rotation  # noqa: F401 - verify the compiled NumPy ABI before ROS starts
+
+    return packages
+
+
+def apply_source_patch(source, patch):
+    """Apply our ordinary unified diffs, requiring every context/removal line."""
+    original = source.splitlines(keepends=True)
+    lines = patch.splitlines(keepends=True)
+    output, cursor, i = [], 0, 0
+    while i < len(lines):
+        if lines[i].startswith(("--- ", "+++ ")):
+            i += 1
+            continue
+        match = re.fullmatch(r"@@ -(\d+)(?:,(\d+))? \+(\d+)(?:,(\d+))? @@[^\n]*\n", lines[i])
+        if match is None:
+            raise RuntimeError(f"invalid Hongik patch header: {lines[i]!r}")
+        start = int(match[1]) - 1
+        if start < cursor:
+            raise RuntimeError("overlapping Hongik patch hunks")
+        output.extend(original[cursor:start])
+        cursor = start
+        removed = added = 0
+        i += 1
+        while i < len(lines) and not lines[i].startswith("@@ "):
+            prefix, value = lines[i][:1], lines[i][1:]
+            if prefix in (" ", "-"):
+                if cursor >= len(original) or original[cursor] != value:
+                    raise RuntimeError(f"Hongik patch context differs at source line {cursor + 1}")
+                cursor += 1
+                removed += 1
+            if prefix in (" ", "+"):
+                output.append(value)
+                added += 1
+            if prefix not in (" ", "-", "+"):
+                raise RuntimeError("unsupported Hongik patch line")
+            i += 1
+        if removed != int(match[2] or 1) or added != int(match[4] or 1):
+            raise RuntimeError("Hongik patch hunk length differs")
+    output.extend(original[cursor:])
+    return "".join(output)
+
+
+def patched_sources():
+    """Validate the complete patch set before importing any patched module."""
+    root = Path(__file__).parent / "hongik_patches"
+    manifest = json.loads((root / "manifest.json").read_text(encoding="utf-8"))
+    prepared = {}
+    for name, record in manifest.items():
+        if name in sys.modules:
+            raise RuntimeError(f"{name} was already imported; start the KIRO integration entry point in a fresh process")
+        parent, _, _child = name.rpartition(".")
+        parent_spec = importlib.util.find_spec(parent)
+        spec = None if parent_spec is None else importlib.machinery.PathFinder.find_spec(name, parent_spec.submodule_search_locations)
+        if spec is None or spec.origin is None:
+            raise RuntimeError(f"Hongik delivery module {name} is unavailable; source its workspace setup first")
+        source = Path(spec.origin).read_text(encoding="utf-8")
+        if hashlib.sha256(source.encode()).hexdigest() != record["source_sha256"]:
+            raise RuntimeError(f"{spec.origin}: Hongik source revision differs from the reviewed ec00145 patch; nothing started")
+        patched = apply_source_patch(source, (root / record["patch"]).read_text(encoding="utf-8"))
+        if hashlib.sha256(patched.encode()).hexdigest() != record["patched_sha256"]:
+            raise RuntimeError(f"{name}: patched source checksum differs; nothing started")
+        prepared[name] = (spec, compile(patched, spec.origin, "exec"))
+    return prepared
+
+
+def install_patches():
+    prepared = patched_sources()
+
+    class CheckedSourceLoader(importlib.abc.Loader):
+        def __init__(self, code):
+            self.code = code
+
+        def create_module(self, spec):
+            return None
+
+        def exec_module(self, module):
+            exec(self.code, module.__dict__)
+
+    class CheckedSourceFinder(importlib.abc.MetaPathFinder):
+        def find_spec(self, fullname, path=None, target=None):
+            if fullname not in prepared:
+                return None
+            original, code = prepared[fullname]
+            spec = importlib.util.spec_from_loader(fullname, CheckedSourceLoader(code), origin=original.origin)
+            spec.has_location = True
+            return spec
+
+    # scan_l0.__init__ reexports AutoTeach. Intercept its initial import as well,
+    # so the package and Teach1G both refer to the same patched class.
+    finder = CheckedSourceFinder()
+    sys.meta_path.insert(0, finder)
+    try:
+        for name in prepared:
+            importlib.import_module(name)
+    finally:
+        sys.meta_path.remove(finder)
+
+
+def main(args=None):
+    args = list(sys.argv[1:] if args is None else args)
+    if args and args[0] == "--":
+        if len(args) < 2:
+            raise RuntimeError("launch prefix did not supply the original Hongik executable")
+        args = args[2:]
+    entry = sys.modules.get("__main__")
+    if entry is not None and entry.__spec__ is None:
+        # Console scripts otherwise spawn via their generated script, bypassing
+        # the __mp_main__ numerical-package bootstrap below.
+        entry.__spec__ = importlib.util.find_spec(__name__)
+    packages = load_system_numeric_packages()
+    install_patches()
+    from hongik_scan_ros import auto_teach_server as server
+
+    original_server = server.AutoTeachServer
+
+    class LoggedSiteServer(original_server):
+        def __init__(self):
+            super().__init__()
+            for name in ("platform_config", "job_file", "calib_file", "out_root", "kiro_confirm_mode"):
+                self.get_logger().info(f"KIRO site {name}: {self.get_parameter(name).value}")
+
+    server.AutoTeachServer = LoggedSiteServer
+    for package in packages:
+        print(f"KIRO numeric package: {package.__name__} {package.__version__} {package.__file__}", flush=True)
+    print("KIRO Hongik integration: duration_s only; straight ranking; OMPL only for selected fallback; exact checked execution", flush=True)
+    try:
+        server.main(args=args)
+    finally:
+        server.AutoTeachServer = original_server
+
+
+if __name__ == "__mp_main__":
+    # multiprocessing spawn imports this -m entry point before loading the
+    # worker target. Give G1Worker the same NumPy/SciPy pair as the server.
+    load_system_numeric_packages()
+elif __name__ == "__main__":
+    main()
