+++ b/construct_robot/test/test_hongik_joint_selection.py
@@ -0,0 +1,463 @@
+"""Checked-path selection and transmission regressions; no ROS node or hardware."""
+
+import ast
+import hashlib
+import json
+import math
+from pathlib import Path
+import threading
+from types import MethodType, SimpleNamespace as NS
+from typing import Optional
+from unittest.mock import Mock
+
+import numpy as np
+import pytest
+
+from construct_robot.core.hongik_joint_selection import joint_path_cost
+from construct_robot.nodes.hongik_auto_teach_server import apply_source_patch
+
+
+class MotionError(RuntimeError):
+    pass
+
+
+class Abort(RuntimeError):
+    def __init__(self, status, reason, **kwargs):
+        super().__init__(reason)
+
+
+class Result:
+    def __init__(self, **kwargs):
+        self.__dict__.update(kwargs)
+        self.monitor_events = []
+        self.finished = False
+        self.samples = []
+
+
+def identity_fk(q):
+    return np.eye(4)
+
+
+def plan(rotation, sweep=1., travel=1., duration=1., joints=(10.,)):
+    return dict(flange_rotation_deg=rotation, tool_sweep_diagonal_m=sweep,
+                tool_point_travel_max_m=travel, max_joint_rotation_deg=max(joints),
+                joint_rotation_deg=list(joints), duration_s=duration, route="straight")
+
+
+def check(summary, token=None):
+    return dict(ok=True, reason="", plan=summary, _checked_plan=token or object())
+
+
+@pytest.fixture(scope="module")
+def methods():
+    """Execute the reviewed patched methods, including their real control flow.
+
+    ROS-dependent module initialization is excluded so these tests cannot start
+    a node. The import/launch integration is checked separately in a fresh process.
+    """
+    project = Path(__file__).resolve().parents[2]
+    bundle = (project.parent / "hongik_kiro_delivery_2026-10-14_ec00145" /
+              "bundle_2026-10-14_kiro-1g-next_ec00145" / "hongik_fine_sensing_ec00145" / "hongik_fine_sensing")
+    patches = project / "construct_robot/construct_robot/nodes/hongik_patches"
+    manifest = json.loads((patches / "manifest.json").read_text())
+    namespaces = []
+    for name, klass, wanted in [
+        ("scan_l0.autoteach", "AutoTeach", ["_checked_joint_candidates", "_finalize_joint_candidate", "_joint_move", "_plan_acquisition", "_choose_visit_order"]),
+        ("hongik_scan_ros.moveit_adapter", "MoveItJtcBackend",
+         ["check_joint", "_build_joint_plan", "move_checked_joint", "_validate_checked_joint_start", "_move", "_first_invalid"]),
+    ]:
+        pkg, mod = name.split(".")
+        source_path = bundle / pkg / pkg / (mod + ".py")
+        if not source_path.exists():
+            pytest.skip("Hongik ec00145 delivery not present")
+        source = source_path.read_text()
+        row = manifest[name]
+        assert hashlib.sha256(source.encode()).hexdigest() == row["source_sha256"]
+        source = apply_source_patch(source, (patches / row["patch"]).read_text())
+        assert hashlib.sha256(source.encode()).hexdigest() == row["patched_sha256"]
+        tree = ast.parse(source)
+        cls = next(n for n in tree.body if isinstance(n, ast.ClassDef) and n.name == klass)
+        funcs = [n for n in cls.body if isinstance(n, ast.FunctionDef) and n.name in wanted]
+        namespace = dict(np=np, math=math, Optional=Optional, MotionError=MotionError, MotionResult=Result,
+                         JointState=NS, _Abort=Abort, STATUS_REFUSED="REFUSED", STATUS_ABORTED="ABORTED",
+                         _jsonable=lambda v: json.loads(json.dumps(v, default=lambda x: x.tolist())),
+                         tool_keypoints=lambda *a: {"flange": np.zeros(3), "tool": np.array([0., 0., .2])},
+                         body_points_base=lambda T, B: np.asarray(B) @ T[:3, :3].T + T[:3, 3],
+                         _rot_deg=lambda A, B: 0., _rot_angle_deg=lambda A, B: 0.,
+                         _now_ns=lambda: 0, move_plan_text=lambda p: str(p), joint_move_kind=lambda v: "joint",
+                         time=__import__("time"), wait_future=lambda f, t: True,
+                         _measure_speed=lambda x: NS(v_measured_mps=0.),
+                         EnvelopeError=ValueError, JobError=ValueError, _fmtf=lambda v, fmt: str(v),
+                         wrist2_branch_problem=lambda *a: "",
+                         rank_reach_candidates=lambda pool: [c for c in pool if c["ok"]])
+        exec(compile(ast.Module(body=funcs, type_ignores=[]), str(source_path), "exec"), namespace)
+        namespaces.append(NS(**{name: namespace[name] for name in wanted}, globals=namespace))
+    return namespaces
+
+
+def engine(methods, outcomes, timeout=None):
+    teach, _backend = methods
+    be = NS(check_joint=Mock(side_effect=outcomes), move_checked_joint=Mock())
+    obj = NS(rs=NS(backend=be), transit_speed=.1, cfg=NS(v_eff_max_mps=.1), accel=.1,
+             motion_timeout_s=timeout, calib=NS(body_points_eoat=None), job_c=object(),
+             _check_estop=Mock(), _decide=Mock(), _T_now=lambda: np.eye(4),
+             _confirm=Mock(), _check_start_pose=Mock(), _event=Mock(), _p=Mock(),
+             res=NS(n_move_l=0), _motion_sent=False)
+    obj.moves = []
+
+    def record(*args, **kwargs):
+        row = dict(dist_mm=1., **kwargs)
+        obj.moves.append(row)
+        return row
+
+    obj._record_move = record
+    obj._checked_joint_candidates = MethodType(teach._checked_joint_candidates, obj)
+    obj._finalize_joint_candidate = MethodType(teach._finalize_joint_candidate, obj)
+    return obj
+
+
+def candidate(q, **kwargs):
+    return dict(q=np.array([q]), names=["right_joint"], **kwargs)
+
+
+def test_shortest_duration_wins_regardless_of_rotation():
+    winding = plan(352.5, duration=1.)
+    direct = plan(32., duration=10.)
+    assert joint_path_cost(winding) < joint_path_cost(direct)
+
+
+def test_equal_durations_ignore_rotation_geometry_and_keep_original_rank(methods):
+    first = candidate(1., yaw_band_ok=False, condition_rel=.1)
+    second = candidate(2., yaw_band_ok=True, condition_rel=1.)
+    obj = engine(methods, [check(plan(352.5, duration=2., sweep=10.)), check(plan(0., duration=2., sweep=.1))])
+    feasible, _ = obj._checked_joint_candidates([first, second], "move")
+    assert feasible == [first, second]
+
+
+def blocked_check(duration, reason="contacts left-right"):
+    summary = plan(32., duration=duration)
+    summary.update(estimate_only=True, straight_blocked_reason=reason)
+    return dict(ok=False, reason=reason, plan=summary, _checked_plan=None)
+
+
+def test_ompl_only_runs_for_selected_fallback_and_retains_final_plan(methods):
+    finalized = check(plan(352., duration=42., joints=(260.,)))
+    obj = engine(methods, [blocked_check(5.), blocked_check(10.), finalized])
+    candidates, attempts = obj._checked_joint_candidates([candidate(1.), candidate(2.)], "move")
+    assert obj.rs.backend.check_joint.call_count == 2
+    assert attempts[0]["estimate_only"] and attempts[0]["selected"]
+    assert candidates[0]["_joint_needs_ompl"]
+    obj._finalize_joint_candidate(candidates[0], "move")
+    assert [call.kwargs["allow_ompl"] for call in obj.rs.backend.check_joint.call_args_list] == [False, False, True]
+    assert candidates[0]["_joint_check"] is finalized
+    assert candidates[0]["_joint_path_cost"] == (42.,)
+    assert attempts[0]["plan"]["duration_s"] == 42.
+    obj._finalize_joint_candidate(candidates[0], "move")
+    assert obj.rs.backend.check_joint.call_count == 3
+
+
+def test_failed_selected_ompl_does_not_try_other_candidates(methods):
+    obj = engine(methods, [blocked_check(5.), blocked_check(10.), dict(ok=False, reason="OMPL failed", plan=None)])
+    candidates, attempts = obj._checked_joint_candidates([candidate(1.), candidate(2.)], "move")
+    with pytest.raises(Abort, match="OMPL failed"):
+        obj._finalize_joint_candidate(candidates[0], "move")
+    assert obj.rs.backend.check_joint.call_count == 3
+    assert attempts[0]["reason"] == "OMPL failed"
+    obj.rs.backend.move_checked_joint.assert_not_called()
+
+
+def test_timeout_applies_to_actual_final_plan_not_blocked_estimate(methods):
+    obj = engine(methods, [blocked_check(20.), check(plan(32., duration=3.))], timeout=10.)
+    candidates, _ = obj._checked_joint_candidates([candidate(1.)], "move")
+    assert len(candidates) == 1
+    obj._finalize_joint_candidate(candidates[0], "move")
+    assert candidates[0]["_joint_path_cost"] == (3.,)
+
+
+def test_straight_executable_candidate_excludes_blocked_estimates(methods):
+    good = candidate(2.)
+    obj = engine(methods, [blocked_check(1.), check(plan(32., duration=10.))])
+    candidates, _ = obj._checked_joint_candidates([candidate(1.), good], "move")
+    assert candidates == [good]
+    obj._finalize_joint_candidate(good, "move")
+    assert obj.rs.backend.check_joint.call_count == 2
+
+
+def test_blocked_straight_is_retimed_but_never_returned_as_executable(methods, monkeypatch):
+    _, funcs = methods
+    obj, _ = backend(methods)
+    obj._build_joint_plan = MethodType(funcs._build_joint_plan, obj)
+    obj._ompl_waypoints = Mock(side_effect=AssertionError("ranking must not invoke OMPL"))
+    obj._first_invalid.return_value = "contacts left-right"
+    obj.p.chain = lambda: NS(joint_names=["right_joint"], movable_joints=[NS(lower=-10., upper=10.)])
+    obj.cfg.v_eff_max_mps, obj.cfg.default_timeout_s = .1, 10.
+    obj.p.mj.__dict__.update(path_check_tol_m=.001, max_tcp_speed_mps=.1, max_tcp_accel_mps2=.1,
+                            rotation_radius_m=.2, max_joint_velocity_rad_s=.24, max_joint_accel_rad_s2=1., goal_time_margin_s=5.)
+    rt = NS(positions=np.array([[0.], [1.]]), velocities=np.array([[0.], [0.]]), times=np.array([0., 5.]),
+            S=.1, duration=5., v_cruise=.1, time_scale=1., notes=[])
+    for key, value in {
+        "FRAME_ROT_TOL_DEG": .2,
+        "densify_joint_path": lambda W, step: np.asarray(W),
+        "retime_joint_path": Mock(return_value=rt),
+        "joint_path_stats": lambda *a: dict(flange_translation_m=.1, **plan(32., duration=5.)),
+        "JointTrajectory": lambda: NS(points=[]),
+        "JointTrajectoryPoint": lambda: NS(time_from_start=NS()),
+        "FollowJointTrajectory": NS(Goal=lambda: NS(goal_time_tolerance=NS())),
+        "duration_parts": lambda t: (int(t), 0),
+    }.items():
+        monkeypatch.setitem(funcs.globals, key, value)
+    chk = funcs.check_joint(obj, np.array([1.]), .1, .1, allow_ompl=False)
+    assert chk["ok"] is False and chk["_checked_plan"] is None
+    assert chk["plan"]["estimate_only"] and chk["plan"]["duration_s"] == 5.
+    obj._ompl_waypoints.assert_not_called()
+
+
+
+
+@pytest.mark.parametrize("bad", [float("nan"), float("inf"), -1.])
+def test_invalid_path_metrics_refused(bad):
+    with pytest.raises(ValueError):
+        joint_path_cost(plan(32., duration=bad))
+
+
+
+
+def test_all_candidates_checked_and_rejection_logged_with_later_success(methods):
+    obj = engine(methods, [dict(ok=False, reason="contacts left-right", plan=None),
+                           check(plan(352.5, duration=26.)), check(plan(32., duration=12.))])
+    candidates = [candidate(1.), candidate(2.), candidate(3.)]
+    feasible, attempts = obj._checked_joint_candidates(candidates, "acquire_S")
+    assert obj.rs.backend.check_joint.call_count == 3
+    assert feasible[0] is candidates[2]
+    assert attempts[0]["reason"] == "contacts left-right"
+    assert [row["selected"] for row in attempts] == [False, False, True]
+    assert attempts[1]["reason"].startswith("not selected")
+    assert all(call.kwargs["allow_ompl"] is False for call in obj.rs.backend.check_joint.call_args_list)
+    assert obj._decide.call_args.kwargs["candidates"][0]["reason"] == "contacts left-right"
+
+
+def test_over_timeout_candidate_does_not_hide_executable_candidate(methods):
+    obj = engine(methods, [check(plan(1., duration=20.)), check(plan(2., duration=2.))], timeout=10.)
+    feasible, attempts = obj._checked_joint_candidates([candidate(1.), candidate(2.)], "move")
+    assert feasible[0]["q"].tolist() == [2.]
+    assert not attempts[0]["ok"] and "timeout" in attempts[0]["reason"]
+
+
+def test_missing_checked_handle_refused(methods):
+    obj = engine(methods, [dict(ok=True, plan=plan(1.), reason="")])
+    feasible, attempts = obj._checked_joint_candidates([candidate(1.)], "move")
+    assert not feasible and "retain" in attempts[0]["reason"]
+
+
