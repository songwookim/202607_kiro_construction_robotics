@@ -0,0 +1,36 @@
+"""Hongik sensing launch with the version-checked KIRO trajectory integration."""
+
+import importlib.util
+from pathlib import Path
+
+from ament_index_python.packages import get_package_share_directory
+from launch import LaunchDescription
+from launch.actions import DeclareLaunchArgument
+
+
+def generate_launch_description():
+    # Keep the delivered launch's parameters, TF, namespace and profiler setup.
+    source = Path(get_package_share_directory("hongik_scan_ros")) / "launch" / "hongik_moveit.launch.py"
+    spec = importlib.util.spec_from_file_location("_kiro_hongik_sensing_launch", source)
+    module = importlib.util.module_from_spec(spec)
+    spec.loader.exec_module(module)
+    original_node = module.Node
+
+    def integrated_node(*args, **kwargs):
+        if kwargs.get("package") == "hongik_scan_ros" and kwargs.get("executable") == "hongik_auto_teach_server":
+            # The existing executable is resolved by launch; the prefix dispatches
+            # to our integration module. This also works before rebuilding scripts.
+            kwargs["prefix"] = "/usr/bin/python3 -m construct_robot.nodes.hongik_auto_teach_server --"
+            kwargs.setdefault("additional_env", {})["PYTHONNOUSERSITE"] = "1"
+        return original_node(*args, **kwargs)
+
+    module.Node = integrated_node
+    description = module.generate_launch_description()
+    actions = []
+    for action in description.entities:
+        if isinstance(action, DeclareLaunchArgument) and action.name in ("platform_config", "job_file", "out_root"):
+            action = DeclareLaunchArgument(action.name, description="Required site setting; see KIRO_RUN_MANUAL.md steps 2, 4, 5")
+        elif isinstance(action, DeclareLaunchArgument) and action.name == "kiro_confirm_mode":
+            action = DeclareLaunchArgument(action.name, default_value="each", description="PrecisionSensing per-move confirmation mode")
+        actions.append(action)
+    return LaunchDescription(actions)
diff --git a/construct_robot/test/test_hongik_joint_selection.py b/construct_robot/test/test_hongik_joint_selection.py
