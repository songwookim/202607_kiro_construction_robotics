<?xml version="1.0"?>
<?xml-model
   href="http://download.ros.org/schema/package_format3.xsd"
   schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>eoat_description</name>
  <version>0.1.0</version>
  <description>Welding torch + VC nano 3D-Z profiler EOAT description: xacro macro (frames eoat_base_link, laser_link, weld_link, profiler_optical_frame, torch_tcp), single STL mesh, sensor calibration YAML (calib/)</description>
  <maintainer email="jm68112@gmail.com">DBCM Lab</maintainer>
  <license>Apache 2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>xacro</exec_depend>

  <test_depend>python3-pytest</test_depend>
  <test_depend>python3-numpy</test_depend>
  <test_depend>python3-scipy</test_depend>
  <test_depend>python3-yaml</test_depend>
  <test_depend>ament_index_python</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
